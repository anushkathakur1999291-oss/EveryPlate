{
  "name": "surplus-to-shelter-backend",
  "version": "1.0.0",
  "description": "Real-Time Food Rescue Routing Backend",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node src/seed.ts",
    "test:domain": "node scripts/test-regression.mjs domain",
    "test:matching": "node scripts/test-regression.mjs matching",
    "test:fulfillment": "node scripts/test-regression.mjs fulfillment",
    "test:api": "node scripts/test-regression.mjs api",
    "test:socket": "node scripts/test-regression.mjs socket",
    "test:impact": "node scripts/test-regression.mjs impact",
    "test:ai": "node scripts/test-regression.mjs ai",
    "demo": "node scripts/demo.mjs",
    "test": "node scripts/test-hardening.mjs && node scripts/test-regression.mjs",
    "test:hardening": "node scripts/test-hardening.mjs",
    "db:deploy": "prisma migrate deploy",
    "auth:set-password": "ts-node src/scripts/set-password.ts",
    "account:create": "ts-node src/scripts/create-account.ts",
    "test:regression": "node scripts/test-regression.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "zod": "^3.24.2",
    "prisma": "^6.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
