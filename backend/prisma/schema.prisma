generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  DONOR
  RECEIVER
  DRIVER
  ADMIN
}

enum NeedLevel {
  LOW
  MEDIUM
  HIGH
}

enum DonationStatus {
  CREATED
  MATCHING
  PARTIALLY_MATCHED
  FULLY_MATCHED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum AllocationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  FULFILLING
  COMPLETED
  CANCELLED
}

enum CapacityReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

enum DeliveryMode {
  PLATFORM_DRIVER
  RECEIVER_LOGISTICS
}

enum DeliveryStatus {
  PENDING_DISPATCH
  DRIVER_SEARCH
  DRIVER_ASSIGNED
  RECEIVER_LOGISTICS_ASSIGNED
  EN_ROUTE_TO_PICKUP
  PICKED_UP
  EN_ROUTE_TO_RECEIVER
  DELIVERED
  COMPLETED
  DRIVER_CANCELLED
  RECEIVER_LOGISTICS_CANCELLED
  DELIVERY_FAILED
  REASSIGNMENT_REQUIRED
  LOGISTICS_SWITCH_REQUIRED
  EXPIRED
}

enum DriverAssignmentStatus {
  OFFERED
  ACCEPTED
  CANCELLED
  COMPLETED
}

enum ReceiverLogisticsStatus {
  ASSIGNED
  EN_ROUTE_PICKUP
  PICKED_UP
  EN_ROUTE_RECEIVER
  DELIVERED
  CANCELLED
}

enum OTPType {
  PICKUP
  DELIVERY
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  name          String
  role          Role
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  donorProfile    DonorProfile?
  receiverProfile ReceiverProfile?
  driverProfile   DriverProfile?
  notifications   Notification[]
  passwordHash    String?
  sessions        Session[]
}

model DonorProfile {
  id               String     @id @default(uuid())
  userId           String     @unique
  organizationName String
  donorType        String     // RESTAURANT, GROCERY, CAFETERIA, CATERER
  address          String
  latitude         Float
  longitude        Float
  phone            String     // Kept private server-side
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations        Donation[]
}

model ReceiverProfile {
  id                       String               @id @default(uuid())
  userId                   String               @unique
  organizationName         String
  maxCapacity              Int                  // Total storage/meal capacity
  currentOccupancy         Int                  @default(0)
  reservedIncomingQuantity Int                  @default(0) // Available = maxCapacity - currentOccupancy - reservedIncomingQuantity
  needLevel                NeedLevel            @default(MEDIUM)
  foodPreferences          String               // JSON array of strings e.g. ["COOKED_MEALS", "PACKAGED_GOODS", "PRODUCE"]
  acceptingDonations       Boolean              @default(true)
  address                  String
  latitude                 Float
  longitude                Float
  phone                    String               // Kept private server-side
  hasOwnLogistics          Boolean              @default(false)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations              DonationAllocation[]
  capacityReservations     CapacityReservation[]
}

model DriverProfile {
  id               String             @id @default(uuid())
  userId           String             @unique
  fullName         String
  vehicleType      String             // BIKE, CAR, VAN, FOOT
  currentLatitude  Float?
  locationUpdatedAt DateTime?
  currentLongitude Float?
  isAvailable      Boolean            @default(true)
  phone            String             // Kept private server-side
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments      DriverAssignment[]
}

model Donation {
  id                   String               @id @default(uuid())
  donorId              String
  foodCategory         String               // COOKED_MEALS, PACKAGED_GOODS, PRODUCE, BAKERY, DAIRY
  foodDescription      String
  quantity             Int                  // Total quantity (e.g. meals)
  unit                 String               @default("meals")
  pickupAddress        String
  pickupLatitude       Float
  pickupLongitude      Float
  availableAt          DateTime             // Earliest pickup availability
  safeDeadline         DateTime             // Safe-donation expiration deadline
  imageUrl             String?
  notes                String?
  nextMatchAttemptAt   DateTime?
  status               DonationStatus       @default(CREATED)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  donor                DonorProfile         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  allocations          DonationAllocation[]
  @@index([donorId, createdAt])
  @@index([status, safeDeadline])
  @@index([status, nextMatchAttemptAt, safeDeadline])

}

model DonationAllocation {
  id                   String               @id @default(uuid())
  donationId           String
  receiverId           String
  allocatedQuantity    Int                  // Can be full or partial donation
  status               AllocationStatus     @default(PROPOSED)
  rejectionReason      String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  donation             Donation             @relation(fields: [donationId], references: [id], onDelete: Cascade)
  receiver             ReceiverProfile      @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  capacityReservation  CapacityReservation?
  delivery             Delivery?
  @@index([donationId, status])
  @@index([receiverId, createdAt])

}

model CapacityReservation {
  id                   String                     @id @default(uuid())
  receiverId           String
  allocationId         String                     @unique
  reservedQuantity     Int
  status               CapacityReservationStatus  @default(ACTIVE)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  receiver             ReceiverProfile            @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  allocation           DonationAllocation        @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  @@index([receiverId, status])

}

model Delivery {
  id                          String                       @id @default(uuid())
  allocationId                String                       @unique
  deliveryMode                DeliveryMode
  status                      DeliveryStatus               @default(PENDING_DISPATCH)
  pickupOtp                   String                       // 4-digit token held by donor
  deliveryOtp                 String                       // 4-digit token held by receiver
  pickupOtpVersion            Int                          @default(1)
  deliveryOtpVersion          Int                          @default(1)
  pickupOtpReissuedAt          DateTime?
  deliveryOtpReissuedAt        DateTime?
  pickupVerifiedAt            DateTime?
  deliveryVerifiedAt          DateTime?
  startedAt                   DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  allocation                  DonationAllocation          @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  driverAssignments           DriverAssignment[]
  receiverLogisticsAssignment ReceiverLogisticsAssignment?
  events                      DeliveryEvent[]
  otpVerifications            OTPVerification[]
  locationEvents              LocationEvent[]
  impactRecord                ImpactRecord?
  @@index([status, deliveryMode, createdAt])

}

model DriverAssignment {
  id                  String                 @id @default(uuid())
  deliveryId          String
  driverId            String
  status              DriverAssignmentStatus @default(OFFERED)
  cancellationReason  String?
  assignedAt          DateTime               @default(now())
  cancelledAt         DateTime?

  delivery            Delivery               @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driver              DriverProfile          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  @@index([driverId, status])
  @@index([deliveryId, status])

}

model ReceiverLogisticsAssignment {
  id                  String                  @id @default(uuid())
  deliveryId          String                  @unique
  driverName          String
  vehicleInfo         String?
  contactMechanism    String?
  status              ReceiverLogisticsStatus @default(ASSIGNED)
  cancellationReason  String?
  assignedAt          DateTime                @default(now())
  cancelledAt         DateTime?

  delivery            Delivery                @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryEvent {
  id                  String       @id @default(uuid())
  deliveryId          String
  fromStatus          String?
  toStatus            String
  actorId             String?
  actorRole           String?
  metadata            String?      // JSON string for additional context
  timestamp           DateTime     @default(now())

  delivery            Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  @@index([deliveryId, timestamp])

}

model OTPVerification {
  id                  String       @id @default(uuid())
  deliveryId          String
  otpType             OTPType
  generation          Int          @default(1)
  submittedOtp        String
  isSuccessful        Boolean
  verifiedByUserId    String?
  timestamp           DateTime     @default(now())

  delivery            Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  @@index([deliveryId, otpType, generation, isSuccessful])

}

model LocationEvent {
  id                  String       @id @default(uuid())
  deliveryId          String
  latitude            Float
  longitude           Float
  source              String       // PLATFORM_DRIVER, RECEIVER_LOGISTICS
  timestamp           DateTime     @default(now())

  delivery            Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  @@index([deliveryId, timestamp])

}

model Notification {
  id                  String       @id @default(uuid())
  userId              String
  title               String
  message             String
  type                String
  referenceId         String?
  isRead              Boolean      @default(false)
  createdAt           DateTime     @default(now())

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead, createdAt])

}

model ImpactRecord {
  id                       String       @id @default(uuid())
  deliveryId               String       @unique
  allocationId             String
  donationId               String
  mealsRescued             Int
  weightDivertedKg         Float
  co2eAvoidedKg            Float
  deliveryMode             DeliveryMode
  matchingDurationMinutes  Float?
  pickupDurationMinutes    Float?
  deliveryDurationMinutes  Float?
  totalDurationMinutes     Float?
  completedAt              DateTime     @default(now())

  delivery                 Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  @@index([completedAt])

}

model Session {
  tokenHash String @id
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model DriverClaim {
  id String @id @default(uuid())
  deliveryId String
  driverId String
  latitude Float
  longitude Float
  closesAt DateTime
  status String @default("PENDING")
  createdAt DateTime @default(now())
  @@unique([deliveryId, driverId, closesAt])
  @@index([deliveryId, status, closesAt])
}
